# Local / Vercel: Vite only exposes vars prefixed with VITE_ at build time.
# On Vercel: Project → Settings → Environment Variables → add VITE_API_URL, then Redeploy.
VITE_API_URL=https://xta.check-outnow.com/api/v1/xtrapay

# Optional (AI Studio / local tooling)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
